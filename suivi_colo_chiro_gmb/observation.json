  ],


  "display_list": [
    "cd_nom",
    "nombre_individus",
    "stade_de_vie",
    "sexe",
    "statut_observation"
  ],

  "keep": [
    "methode_observation",
    "etat_biologique",
    "methode_determination",
    "statut_observation",
    "statut_source",
    "sexe"
  ],

  "specific": {

    "cd_nom": {
        "type_widget": "taxonomy",
        "attribut_label": "Taxon observé",
        "type_util": "taxonomy",
        "required": true,
        "id_list": "__MODULE.ID_LIST_TAXONOMY"
    },

    "methode_observation": {
      "type_widget": "nomenclature",
      "attribut_label": "Méthode d'observation",
      "code_nomenclature_type": "METH_OBS",
      "type_util": "nomenclature",
      "required": true,
      "cd_nomenclatures": ["20","6","3","0","25"],
      "value": {
        "cd_nomenclature": "0"
      }
    },



    "etat_biologique": {
      "type_widget": "nomenclature",
      "attribut_label": "Etat biologique de l'observation",
      "code_nomenclature_type": "ETA_BIO",
      "type_util": "nomenclature",
      "required": true,
      "cd_nomenclatures": ["2","3"],
      "value": {
        "cd_nomenclature": "2"
      }
    },


    "methode_determination": {
      "type_widget": "nomenclature",
      "attribut_label": "Méthode de détermination",
      "code_nomenclature_type": "METH_DETERMIN",
      "type_util": "nomenclature",
      "required": true,
       "cd_nomenclatures": ["9","10","14","15","17","18","22"],
      "value": {
        "cd_nomenclature": "18"
      }
    },


    "statut_biologique": {
      "type_widget": "select",
      "attribut_label": "Statut biologique de l'espèce saisie",
      "values": ["Estivation","Hibernation","Reproduction (mise-bas et l'élevage des jeunes)","Swarming (accouplements)","Inconnu ou Incertain"],
      "required": true
    },


    "statut_observation": {
      "type_widget": "nomenclature",
      "attribut_label": "Statut d'observation",
      "code_nomenclature_type": "STATUT_OBS",
      "type_util": "nomenclature",
      "required": true,
      "cd_nomenclatures": ["No","Pr"],
      "value": {
        "cd_nomenclature": "Pr"
      }
    },

    "statut_source": {
      "type_widget": "nomenclature",
      "attribut_label": "Statut de la source",
      "code_nomenclature_type": "STATUT_SOURCE",
      "type_util": "nomenclature",
      "required": true,
      "value": {
        "cd_nomenclature": "Te"
      }
    },


    "stade_de_vie": {
      "type_widget": "nomenclature",
      "attribut_label": "Stade de vie des individus dénombrés",
      "code_nomenclature_type": "STADE_VIE",
      "type_util": "nomenclature",
      "required": true,
      "cd_nomenclatures": ["2","1","3"]
    },


    "sexe": {
      "type_widget": "nomenclature",
      "attribut_label": "Sexe des individus dénombrés",
      "code_nomenclature_type": "SEXE",
      "type_util": "nomenclature",
      "required": false,
      "cd_nomenclatures": ["2","3","0"],
      "value": {
        "cd_nomenclature": "0"
      }
    },


    "nombre_individus": {
        "type_widget": "number",
        "attribut_label": "Effectif",
        "required": true
    },


    "comments":{
      "attribut_label": "Remarques",
      "type_widget": "textarea"
    }


  }

}
