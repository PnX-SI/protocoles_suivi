{
  "display_properties": [
    "uuid_observation",
    "cd_nom",
    "technique_observation",
    "etat_biologique",
    "statut_observation",
    "methode_deter",
    "nombre_individus",
    "stade_de_vie",
    "sexe",
    "comments"
  ],

  "display_list": [
    "uuid_observation",
    "cd_nom",
    "etat_biologique",
    "statut_observation"
  ],

  "keep": ["statut_source"],

  "specific": {
    "cd_nom": {
      "type_widget": "taxonomy",
      "attribut_label": "Taxon",
      "type_util": "taxonomy",
      "required": true,
      "id_list": "__MODULE.ID_LIST_TAXONOMY"
    },

    "technique_observation": {
      "type_widget": "nomenclature",
      "attribut_label": "Méthode d'observation",
      "code_nomenclature_type": "METH_OBS",
      "group2inpn": "Mammifères",
      "type_util": "nomenclature",
      "required": true,
      "cd_nomenclatures": [
        "9008",
        "20",
        "4",
        "27",
        "1",
        "6",
        "21",
        "9008",
        "12",
        "23",
        "3",
        "0"
      ],
      "value": {
        "cd_nomenclature": "23"
      }
    },

    "etat_biologique": {
      "type_widget": "nomenclature",
      "attribut_label": "Etat biologique de l'observation",
      "code_nomenclature_type": "ETA_BIO",
      "type_util": "nomenclature",
      "required": false,
      "cd_nomenclatures": ["0", "2", "3", "9001"],
      "value": {
        "cd_nomenclature": "2"
      }
    },

    "statut_observation": {
      "type_widget": "nomenclature",
      "attribut_label": "Statut d'observation",
      "code_nomenclature_type": "STATUT_OBS",
      "type_util": "nomenclature",
      "required": true,
      "value": {
        "cd_nomenclature": "Pr"
      }
    },

    "statut_source": {
      "type_widget": "nomenclature",
      "attribut_label": "Statut de la source",
      "code_nomenclature_type": "STATUT_SOURCE",
      "type_util": "nomenclature",
      "hidden": true,
      "value": {
        "cd_nomenclature": "Te"
      }
    },

    "methode_deter": {
      "type_widget": "nomenclature",
      "attribut_label": "Méthode de détermination",
      "code_nomenclature_type": "METH_DETERMIN",
      "type_util": "nomenclature",
      "required": true,
      "cd_nomenclatures": ["9", "16", "17", "18", "22"]
    },

    "stade_de_vie": {
      "type_widget": "nomenclature",
      "attribut_label": "Stade de vie",
      "code_nomenclature_type": "STADE_VIE",
      "type_util": "nomenclature",
      "required": true,
      "cd_nomenclatures": ["2", "1", "3", "5"],
      "value": {
        "cd_nomenclature": "1"
      }
    },

    "nombre_individus": {
      "type_widget": "number",
      "attribut_label": "Nombre d'individus",
      "hidden": "({value, meta}) => (meta.nomenclatures[value.technique_observation] || {}).cd_nomenclature !== '0'",
      "required": "({value, meta}) => (meta.nomenclatures[value.technique_observation] || {}).cd_nomenclature === '0'"
    },

    "sexe": {
      "type_widget": "nomenclature",
      "attribut_label": "Sexe",
      "code_nomenclature_type": "SEXE",
      "type_util": "nomenclature",
      "cd_nomenclatures": ["2", "0", "3"],
      "value": {
        "cd_nomenclature": "0"
      },
      "hidden": "({value, meta}) => (meta.nomenclatures[value.technique_observation] || {}).cd_nomenclature !== '0'",
      "required": "({value, meta}) => (meta.nomenclatures[value.technique_observation] || {}).cd_nomenclature === '0'"
    },

    "comments": {
      "type_widget": "textarea",
      "required": false
    }
  }
}
