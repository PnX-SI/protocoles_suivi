{
  "display_properties": [
    "id_base_site",
    "observers",
    "visit_date_min",
    "visit_duration",
    "id_nomenclature_aire_activity",
    "nb_adulte",
    "nb_jeune_blanc",
    "nb_jeune_noir",
    "comments",
    "bilan_final",
    "id_nomenclature_reprodution_status"
  ],
  "display_list": ["visit_date_min", "observers"],
  "label": "Contrôle",
  "genre": "M",
  "map_label_field_name": "base_site_name",
  "specific": {
    "id_dataset": {
      "hidden": "({meta}) => meta.dataset && Object.keys(meta.dataset).length == 1"
    },
    "comments": {
      "type_widget": "textarea"
    },
    "visit_duration": {
      "type_widget": "number",
      "attribut_label": "Durée de la visite (en heure)",
      "required": true,
      "min": 0,
      "max": 20
    },
    "id_nomenclature_aire_activity": {
      "type_widget": "nomenclature",
      "attribut_label": "Activités liées à l'aire",
      "code_nomenclature_type": "AIGLE_ACTIVITE_AIRE",
      "type_util": "nomenclature",
      "multi_select": true,
      "required": false
    },
    "nb_adulte": {
      "type_widget": "number",
      "attribut_label": "Nombre d'adulte",
      "required": false,
      "min": 0,
      "max": 20
    },
    "nb_jeune_blanc": {
      "type_widget": "number",
      "attribut_label": "Nombre de jeune blanc",
      "required": false,
      "min": 0,
      "max": 20
    },
    "nb_jeune_noir": {
      "type_widget": "number",
      "attribut_label": "Nombre de jeune noir",
      "required": false,
      "min": 0,
      "max": 20
    },
    "bilan_final": {
      "type_widget": "bool_checkbox",
      "attribut_label": "Bilan final (statut expert)",
      "value": false
    },
    "id_nomenclature_reprodution_status": {
      "type_widget": "nomenclature",
      "attribut_label": "Statut de reproduction 'expert' ; à modifier si besoin:",
      "code_nomenclature_type": "AIGLE_STATUT_REPRODUCTION",
      "type_util": "nomenclature",
      "hidden": "({value}) => !value.bilan_final"
    },
    "medias": {
      "hidden": true,
      "type_widget": "medias",
      "attribut_label": "Médias",
      "schema_dot_table": "gn_monitoring.t_base_visits"
    },
    "nb_observations": {
      "attribut_label": "Nombre d'observations",
      "type_widget": "number",
      "hidden": true
    }
  }
}
