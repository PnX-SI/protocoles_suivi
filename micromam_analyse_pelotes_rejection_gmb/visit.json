{
  "display_properties": [
    "uuid_base_visit",
    "id_dataset",
    "id_nomenclature_tech_collect_campanule",
    "pelotes",
    "visit_date_min",
    "visit_date_max",
    "observers",
    "determinateur",
    "nombre",
    "predateur",
    "comments",
    "nb_observations"
  ],

  "display_list": [
    "visit_date_min",
    "pelotes",
    "nombre",
    "predateur",
    "nb_observations"
  ],

  "specific": {
    "id_nomenclature_tech_collect_campanule": {
      "type_widget": "nomenclature",
      "attribut_label": "Technique de collecte (Campanule)",
      "code_nomenclature_type": "TECHNIQUE_OBS",
      "type_util": "nomenclature",
      "hidden": true,
      "cd_nomenclatures": ["2"],
      "value": {
        "cd_nomenclature": "2"
      }
    },

    "pelotes": {
      "type_widget": "radio",
      "attribut_label": "Présence de pelotes ?",
      "values": ["Oui", "Non"],
      "value": "Oui",
      "required": true
    },

    "visit_date_min": {
      "attribut_label": "Date de la collecte des pelotes",
      "hidden": false,
      "required": true
    },

    "visit_date_max": {
      "attribut_label": "Date de la détermination des restes osseux",
      "hidden": false,
      "required": "({value}) => value.pelotes == 'Oui'"
    },

    "observers": {
      "type_widget": "datalist",
      "attribut_label": "Observateurs",
      "api": "users/menu/__MODULE.ID_LIST_OBSERVER",
      "application": "GeoNature",
      "keyValue": "id_role",
      "keyLabel": "nom_complet",
      "type_util": "user",
      "multiple": true,
      "required": true
    },

    "determinateur": {
      "type_widget": "datalist",
      "attribut_label": "Déterminateurs",
      "api": "users/menu/__MODULE.ID_LIST_OBSERVER",
      "application": "GeoNature",
      "keyValue": "id_role",
      "keyLabel": "nom_complet",
      "type_util": "user",
      "multiple": true,
      "required": true
    },

    "nombre": {
      "type_widget": "number",
      "required": "({value}) => value.pelotes == 'Oui'",
      "attribut_label": "Nombre total de proies mammaliennes dans les pelotes"
    },

    "predateur": {
      "type_widget": "nomenclature",
      "attribut_label": "Prédateur occupant le site",
      "code_nomenclature_type": "PRED_PELOTES",
      "type_util": "nomenclature",
      "hidden": false
    },
    "comments": {
      "attribut_label": "Remarques",
      "type_widget": "textarea"
    }
  }
}
