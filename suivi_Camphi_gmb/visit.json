{
  "display_properties": [
    "uuid_base_visit",
    "id_dataset",
    "visit_date_min",
    "observers",
    "cadre_prosp",
    "cadre_precis",
    "hab_arsa",
    "ty_habarsa",
    "hab_arsa_vg_dom",
    "hab_arsa_vg_fav",
    "megaph",
    "gestion",
    "acces_riv",
    "comments"
  ],

  "display_list": [
    "uuid_observation",
    "num_prosp",
    "id_dataset",
    "visit_date_min",
    "observers",
    "nb_observations"
  ],

  "keep": [
    "id_nomenclature_tech_collect_campanule",
    "id_dataset",
    "observers"
  ],


  "specific" :{

    "id_nomenclature_tech_collect_campanule": {
      "type_widget": "nomenclature",
      "attribut_label": "Technique de collecte (Campanule)",
      "code_nomenclature_type": "TECHNIQUE_OBS",
      "type_util": "nomenclature",
      "required": false,
      "value": {
        "cd_nomenclature": "57"
      },
      "hidden": true
    },

    "cadre_prosp": {
      "type_widget": "select",
      "required": true,
      "attribut_label": "Cadre dans lequel la prospection est menée",
      "values": ["Suivi/Inventaire Régional","Inventaire local","Suivi local","Suivi Site"],
      "value": "Suivi Régional"
    },

    "cadre_precis": {
      "type_widget": "text",
      "attribut_label": "Précisions sur le cadre: nom de l'étude, du wepta, etc."
    },


    "hab_arsa": {
      "type_widget": "radio",
      "attribut_label": "Présence d'habitat favorable au Campagnol amphibie",
      "values": ["Oui", "Non"],
      "value": "Non"
    },

    "ty_habarsa": {
      "type_widget": "nomenclature",
      "attribut_label": "Type d'habitat favorable au Campagnol amphibie ?",
      "code_nomenclature_type": "TYPE_HAB_ARSA",
      "type_util": "nomenclature",
      "required": false,
      "value": {
        "cd_nomenclature": "NR"
      },
      "multiple": true,
      "hidden": "({value}) => value.hab_arsa != 'Oui'"
    },

    "hab_arsa_vg_dom": {
      "type_widget": "nomenclature",
      "attribut_label": "Végétation dominante de l'habitat favorable au Campagnol amphibie",
      "code_nomenclature_type": "HAB_ARSA_VG_DOM",
      "type_util": "nomenclature",
      "required": false,
      "hidden": "({value}) => value.hab_arsa != 'Oui'"

    },

    "hab_arsa_vg_fav": {
      "type_widget": "nomenclature",
      "attribut_label": "Formation végétale favorable au Campagnol amphibie suffisamment présente pour constituer un habitat",
      "code_nomenclature_type": "HAB_ARSA_VG_FAV",
      "type_util": "nomenclature",
      "required": false,
      "multiple": true,
      "hidden": "({value}) => value.hab_arsa != 'Oui'"
    },

    "megaph": {
      "type_widget": "text",
      "attribut_label": "Si 'Autre mégaphorbiaie' : préciser le type de Mégaphorbiaie",
      "hidden": "({value}) => value.hab_arsa != 'Oui'"
    },


    "gestion": {
      "type_widget": "nomenclature",
      "attribut_label": "Type de Gestion",
      "code_nomenclature_type": "GESTION",
      "type_util": "nomenclature",
      "required": false,
      "hidden": "({value}) => value.hab_arsa != 'Oui'",
      "value": {
        "cd_nomenclature": "NR"
      }
    },


    "acces_riv": {
      "type_widget": "nomenclature",
      "attribut_label": "Accès du bétail aux berges",
      "code_nomenclature_type": "ACCES_RIV",
      "type_util": "nomenclature",
      "required": false,
      "hidden": "({value, meta}) => (meta.nomenclatures[value.gestion] || {}).cd_nomenclature != 'PATUR' || value.saisie_details_arsa =='Non'",
      "value": {
        "cd_nomenclature": "NR"
      }
    },


    "comments":{
      "attribut_label": "Remarques",
      "type_widget": "textarea"
    }

  }
}


