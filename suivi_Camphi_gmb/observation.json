{
  "display_properties": [
    "uuid_observation",
    "cd_nom",
    "nombre_individus",
    "technique_observation",
    "etat_biologique",
    "statut_observation",
    "statut_source",
    "comments",
    "indices",
    "densit_fs",
    "nb_fs"
  ],

  "display_list": [
    "uuid_observation",
    "cd_nom",
    "nombre_individus",
    "etat_biologique",
    "statut_observation"
  ],

  "keep": ["statut_source", "technique_observation"],

  "specific": {
    "cd_nom": {
      "type_widget": "taxonomy",
      "attribut_label": "Taxon",
      "type_util": "taxonomy",
      "required": true,
      "id_list": "__MODULE.ID_LIST_TAXONOMY"
    },

    "nombre_individus": {
      "type_widget": "number",
      "attribut_label": "Nombre d'individus",
      "required": false
    },

    "technique_observation": {
      "type_widget": "nomenclature",
      "attribut_label": "Méthode d'observation",
      "code_nomenclature_type": "METH_OBS",
      "type_util": "nomenclature",
      "required": true,
      "cd_nomenclatures": [
        "23",
        "6",
        "4",
        "27",
        "12",
        "23",
        "9008",
        "8",
        "9010",
        "0",
        "1",
        "26",
        "9009",
        "9011"
      ],
      "value": {
        "cd_nomenclature": "6"
      }
    },

    "etat_biologique": {
      "type_widget": "nomenclature",
      "attribut_label": "Etat biologique de l'observation",
      "code_nomenclature_type": "ETA_BIO",
      "data_path": "values",
      "type_util": "nomenclature",
      "required": true,
      "value": {
        "cd_nomenclature": "2"
      }
    },

    "statut_observation": {
      "type_widget": "nomenclature",
      "attribut_label": "Statut d'observation",
      "code_nomenclature_type": "STATUT_OBS",
      "type_util": "nomenclature",
      "required": true,
      "value": {
        "cd_nomenclature": "Pr"
      }
    },

    "statut_source": {
      "type_widget": "nomenclature",
      "attribut_label": "Statut de la source",
      "code_nomenclature_type": "STATUT_SOURCE",
      "type_util": "nomenclature",
      "required": false,
      "hidden": true,
      "value": {
        "cd_nomenclature": "Te"
      }
    },

    "comments": {
      "attribut_label": "Remarques",
      "type_widget": "textarea"
    },

    "indices": {
      "type_widget": "nomenclature",
      "attribut_label": "Indices observés",
      "code_nomenclature_type": "INDICES_ARSA",
      "type_util": "nomenclature",
      "required": false,
      "multiple": true,
      "value": {
        "cd_nomenclature": "CROTTIERS"
      },
      "hidden": "({value}) => !(value.cd_nom && value.cd_nom.cd_nom == 61258)"
    },

    "densit_fs": {
      "type_widget": "nomenclature",
      "attribut_label": "Densité d'indices observés",
      "code_nomenclature_type": "DENSITE_FS",
      "type_util": "nomenclature",
      "required": false,
      "multiple": false,
      "value": {
        "cd_nomenclature": "NR"
      },
      "hidden": "({value}) => !(value.cd_nom && value.cd_nom.cd_nom == 61258)"
    },

    "nb_fs": {
      "type_widget": "number",
      "attribut_label": "Nombre de crottiers",
      "required": false,
      "hidden": "({value}) => !(value.cd_nom && value.cd_nom.cd_nom == 61258)"
    }
  }
}
