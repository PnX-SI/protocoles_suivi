{
  "description_field_name": "cd_nom",
  "genre": "F",
  "display_properties": [
    "cd_nom",
    "abondance",
    "id_nomenclature_behaviour",
    "id_nomenclature_life_stage",
    "comments"
  ],
  "display_list": ["cd_nom", "num_tranche", "nombre", "nombre_compte"],
  "specific": {
    "cd_nom": {
      "type_widget": "taxonomy",
      "attribut_label": "Espèce observée",
      "multiple": false,
      "id_list": "__MODULE.ID_LIST_TAXONOMY",
      "application": "TaxHub",
      "required": true,
      "type_util": "taxonomy"
    },
    "abondance": {
      "type_widget": "select",
      "attribut_label": "Abondance",
      "values": [
        {
          "label": "n < 5",
          "value": "R"
        },
        {
          "label": "5 < n < 20",
          "value": "PC"
        },
        {
          "label": "20 < n < 100",
          "value": "C"
        },
        {
          "label": "100 < n",
          "value": "TC"
        }
      ],
      "required": true
    },
    "id_nomenclature_behaviour": {
      "type_widget": "nomenclature",
      "attribut_label": "Type de comportement reproducteur",
      "code_nomenclature_type": "OCC_COMPORTEMENT",
      "type_util": "nomenclature",
      "regne": "Animalia",
      "group2_inpn": "Insectes",
      "cd_nomenclatures": ["1", "23", "19"],
      "multiple": false,
      "required": "({value}) => !value.id_nomenclature_life_stage"
    },
    "id_nomenclature_life_stage": {
      "type_widget": "nomenclature",
      "attribut_label": "Stade de vie",
      "code_nomenclature_type": "STADE_VIE",
      "type_util": "nomenclature",
      "regne": "Animalia",
      "cd_nomenclatures":   ["6", "2"] ,
      "value": {
        "cd_nomenclature": "2"
      },
      "multiple": true,
      "required": "({value}) => !value.id_nomenclature_behaviour"
    },
    "comments": {
      "type_widget": "textarea",
      "attribut_label": "Commentaire"
    }
  }
}
